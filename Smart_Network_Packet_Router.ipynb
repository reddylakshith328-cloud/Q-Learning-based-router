    "TRAINING Q-LEARNING ROUTER"
)
print(
    "=========================================="
)

history = []

episodes = 200


for episode in range(
    1,
    episodes + 1
):

    # Reset queues
    reset_network(G)

    # Add random congestion
    inject_congestion(
        G,
        probability=0.10
    )


    # Run episode
    result = simulate_episode(
        G,
        agent,
        n_packets=150,
        train=True,
        policy="qlearning"
    )


    # Decay epsilon
    agent.decay_exploration()


    # Store results
    history.append(
        (
            result["delay"],
            result["loss"],
            result["pdr"],
            result["jitter"],
            result["throughput"],
            agent.epsilon
        )
    )


    if episode % 20 == 0:

        print(
            f"Episode {episode:3d} | "
            f"Delay: {result['delay']:.2f} ms | "
            f"Loss: {result['loss']:.2f}% | "
            f"PDR: {result['pdr']:.2f}% | "
            f"Epsilon: {agent.epsilon:.4f}"
        )


