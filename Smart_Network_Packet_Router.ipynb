# ============================================================
# 8. STATE DISCRETIZATION
# ============================================================

N_BINS = 4


def discretize(value, bins=N_BINS):
    """
    Normalize a continuous value into a discrete state bin.
    """

    value = max(0.0, min(1.0, float(value)))

    return min(
        int(value * bins),
        bins - 1
    )


# ============================================================
# 9. STATE ENCODING
# ============================================================

def encode_state(
    queue,
    delay,
    utilization,
    congestion
):
    """
    State:
        s = (q, d, u, c)

    q = queue length
    d = link delay
    u = bandwidth utilization
    c = congestion level
    """

    return (
        discretize(queue),
        discretize(delay),
        discretize(utilization),
        discretize(congestion)
    )


# ============================================================
# 10. GET CURRENT NETWORK STATE
# ============================================================

def get_state(G, node, destination):

    queues = []
    delays = []
    utilizations = []

    neighbors = list(G.neighbors(node))

    for neighbor in neighbors:

        data = G[node][neighbor]

        queues.append(
            float(data.get("queue", 0.0))
        )

        delays.append(
            float(data.get("delay", 1.0))
        )

        utilizations.append(
            float(data.get("util", 0.0))
        )

    # --------------------------------------------------------
    # Queue state
    # --------------------------------------------------------

    q = (
        np.mean(queues)
        if queues
        else 0.0
    )

    # --------------------------------------------------------
    # Delay state
    # --------------------------------------------------------

    d = (
        np.mean(delays)
        if delays
        else 0.0
    )

    # Normalize delay
    d = d / 10.0

    # --------------------------------------------------------
    # Utilization state
    # --------------------------------------------------------

    u = (
        np.mean(utilizations)
        if utilizations
        else 0.0
    )

    # --------------------------------------------------------
    # Congestion state
    # --------------------------------------------------------

    c = 0.0

    if queues:
        if max(queues) > 0.7:
            c = 1.0

    return encode_state(
        q,
        d,
        u,
        c
    )


# ============================================================
# 11. Q-LEARNING ROUTER
# ============================================================

class QLearningRouter:

    def __init__(
        self,
        alpha=0.1,
        gamma=0.9,
        epsilon=0.30,
        epsilon_min=0.01,
        epsilon_decay=0.98
    ):

        self.alpha = alpha
        self.gamma = gamma

        self.epsilon = epsilon
        self.epsilon_min = epsilon_min
        self.epsilon_decay = epsilon_decay

        self.q = defaultdict(float)


    # --------------------------------------------------------
    # ε-GREEDY ACTION SELECTION
    # --------------------------------------------------------

    def choose_action(
        self,
        state,
        actions
    ):

        if not actions:
            return None

        # Exploration
        if random.random() < self.epsilon:

            return random.choice(actions)

        # Exploitation
        values = [
            self.q[(state, action)]
            for action in actions
        ]

        best = max(values)

        best_actions = [
            action
            for action, value
            in zip(actions, values)
            if value == best
        ]

        return random.choice(best_actions)


    # --------------------------------------------------------
    # BELLMAN Q-LEARNING UPDATE
    # --------------------------------------------------------

    def update(
        self,
        state,
        action,
        reward,
        next_state,
        next_actions
    ):

        old = self.q[
            (state, action)
        ]

        future = max(
            (
                self.q[
                    (next_state, a)
                ]
                for a in next_actions
            ),
            default=0.0
        )

        target = (
            reward
            + self.gamma * future
        )

        self.q[
            (state, action)
        ] = (
            old
            + self.alpha
            * (target - old)
        )


    # --------------------------------------------------------
    # EPSILON DECAY
    # --------------------------------------------------------

    def decay_exploration(self):

        self.epsilon = max(
            self.epsilon_min,
            self.epsilon
            * self.epsilon_decay
        )


# ============================================================
# 12. REWARD FUNCTION
# ============================================================

def compute_reward(
    delay,
    loss,
    congestion,
    w_delay=1.0,
    w_loss=5.0,
    w_congestion=2.0
):

    return -(
        w_delay * delay
        + w_loss * loss
        + w_congestion * congestion
    )


# ============================================================
# 13. SHORTEST PATH NEXT-HOP
# ============================================================

def shortest_path_next_hop(
    G,
    src,
    dst,
    weight="delay"
):

    try:

        path = nx.shortest_path(
            G,
            src,
            dst,
            weight=weight
        )

        if len(path) > 1:

            return path[1]

        return src

    except nx.NetworkXNoPath:

        return None


# ============================================================
# 14. OSPF-LIKE NEXT HOP
# ============================================================

def ospf_next_hop(
    G,
    src,
    dst
):

    H = G.copy()

    # OSPF link cost = inverse capacity
    for u, v, data in H.edges(data=True):

        capacity = float(
            data.get(
                "capacity",
                1.0
            )
        )

        data["ospf_cost"] = (
            1.0 / max(
                capacity,
                1e-9
            )
        )

    try:

        path = nx.shortest_path(
            H,
            src,
            dst,
            weight="ospf_cost"
        )

        if len(path) > 1:

            return path[1]

        return src

    except nx.NetworkXNoPath:

        return None


# ============================================================
# 15. RIP-LIKE NEXT HOP
# ============================================================

def rip_next_hop(
    G,
    src,
    dst
):

    try:

        path = nx.shortest_path(
            G,
            src,
            dst
        )

        if len(path) > 1:

            return path[1]

        return src

    except nx.NetworkXNoPath:

        return None


# ============================================================
# 16. RESET NETWORK QUEUES
# ============================================================

def reset_network(G):

    for u, v, data in G.edges(data=True):

        data["queue"] = 0.0
        data["util"] = 0.0


# ============================================================
# 17. UPDATE NETWORK QUEUES
# ============================================================

def update_queues(G):

    for u, v, data in G.edges(data=True):

        data["queue"] = max(
            0.0,
            data.get("queue", 0.0)
            - 0.01
        )

        data["util"] = max(
            0.0,
            data.get("util", 0.0)
            - 0.01
        )


# ============================================================
# 18. INJECT CONGESTION
# ============================================================

def inject_congestion(
    G,
    probability=0.10
):

    for u, v, data in G.edges(data=True):

        if random.random() < probability:

            data["queue"] = min(
                1.0,
                data.get("queue", 0.0)
                + random.uniform(
                    0.2,
                    0.5
                )
            )

            data["util"] = min(
                1.0,
                data.get("util", 0.0)
                + random.uniform(
                    0.2,
                    0.5
                )
            )


# ============================================================
# 19. SIMULATE ONE PACKET
# ============================================================

def route_packet(
    G,
    agent,
    src,
    dst,
    train=True,
    policy="qlearning"
):

    current = src

    path = [src]

    path_delay = 0.0

    lost = False

    visited = {src}

    max_hops = (
        G.number_of_nodes()
        * 2
    )

    hops = 0


    # --------------------------------------------------------
    # Forward packet
    # --------------------------------------------------------

    while (
        current != dst
        and hops < max_hops
    ):

        # ----------------------------------------------------
        # State
        # ----------------------------------------------------

        state = get_state(
            G,
            current,
            dst
        )

        neighbors = [
            n
            for n in G.neighbors(current)
            if n not in visited
        ]


        if not neighbors:

            lost = True

            break


        # ----------------------------------------------------
        # Select next-hop
        # ----------------------------------------------------

        if policy == "qlearning":

            if train:

                action = agent.choose_action(
                    state,
                    neighbors
                )

            else:

                q_values = [
                    agent.q[
                        (state, n)
                    ]
                    for n in neighbors
                ]

                action = neighbors[
                    int(
                        np.argmax(
                            q_values
                        )
                    )
                ]


        elif policy == "ospf":

            action = ospf_next_hop(
                G,
                current,
                dst
            )

            if action not in neighbors:

                action = (
                    neighbors[0]
                    if neighbors
                    else None
                )


        elif policy == "rip":

            action = rip_next_hop(
                G,
                current,
                dst
            )

            if action not in neighbors:

                action = (
                    neighbors[0]
                    if neighbors
                    else None
                )

        else:

            action = None


        if action is None:

            lost = True

            break


        # ----------------------------------------------------
        # Link information
        # ----------------------------------------------------

        edge = G[
            current
        ][
            action
        ]


        # ----------------------------------------------------
        # Delay
        # ----------------------------------------------------

        base_delay = float(
            edge.get(
                "delay",
                1.0
            )
        )

        queue = float(
            edge.get(
                "queue",
                0.0
            )
        )

        link_delay = (
            base_delay
            * (1.0 + queue)
        )

        path_delay += link_delay


        # ----------------------------------------------------
        # Packet loss
        # ----------------------------------------------------

        if (
            queue > 0.85
            and random.random() < 0.15
        ):

            lost = True

            break


        # ----------------------------------------------------
        # Increase queue
        # ----------------------------------------------------

        edge["queue"] = min(
            1.0,
            queue + 0.05
        )


        # ----------------------------------------------------
        # Increase utilization
        # ----------------------------------------------------

        edge["util"] = min(
            1.0,
            edge.get(
                "util",
                0.0
            ) + 0.05
        )


        # ----------------------------------------------------
        # Congestion indicator
        # ----------------------------------------------------

        congestion = (
            1.0
            if edge["queue"] > 0.7
            else 0.0
        )


        # ----------------------------------------------------
        # Next state
        # ----------------------------------------------------

        next_state = get_state(
            G,
            action,
            dst
        )

        next_neighbors = [
            n
            for n in G.neighbors(action)
            if n not in visited
        ]


        # ----------------------------------------------------
        # Reward
        # ----------------------------------------------------

        reward = compute_reward(
            link_delay,
            1.0 if lost else 0.0,
            congestion
        )


        # ----------------------------------------------------
        # Q-table update
        # ----------------------------------------------------

        if (
            train
            and policy == "qlearning"
        ):

            agent.update(
                state,
                action,
                reward,
                next_state,
                next_neighbors
            )


        # ----------------------------------------------------
        # Move to next node
        # ----------------------------------------------------

        current = action

        path.append(current)

        visited.add(current)

        hops += 1


        # ----------------------------------------------------
        # Queue decay
        # ----------------------------------------------------

        update_queues(G)


    # ========================================================
    # DELIVERY RESULT
    # ========================================================

    delivered = (
        not lost
        and current == dst
    )

    return {
        "delivered": delivered,
        "lost": not delivered,
        "delay": path_delay,
        "hops": hops,
        "path": path
    }


# ============================================================
# 20. SIMULATE EPISODE
# ============================================================

def simulate_episode(
    G,
    agent,
    n_packets=150,
    train=True,
    policy="qlearning"
):

    nodes = list(G.nodes())

    total_delay = 0.0

    total_loss = 0

    delivered = 0

    delays = []

    hop_counts = []


    # --------------------------------------------------------
    # Generate packets
    # --------------------------------------------------------

    for _ in range(n_packets):

        src, dst = random.sample(
            nodes,
            2
        )


        result = route_packet(
            G,
            agent,
            src,
            dst,
            train=train,
            policy=policy
        )


        if result["delivered"]:

            delivered += 1

            total_delay += (
                result["delay"]
            )

            delays.append(
                result["delay"]
            )

            hop_counts.append(
                result["hops"]
            )

        else:

            total_loss += 1


    # --------------------------------------------------------
    # Metrics
    # --------------------------------------------------------

    avg_delay = (
        total_delay
        / max(
            delivered,
            1
        )
    )

    loss_rate = (
        total_loss
        / n_packets
        * 100
    )

    pdr = (
        delivered
        / n_packets
        * 100
    )


    # --------------------------------------------------------
    # Jitter
    # --------------------------------------------------------

    if len(delays) > 1:

        jitter = float(
            np.std(delays)
        )

    else:

        jitter = 0.0


    # --------------------------------------------------------
    # Throughput estimate
    # --------------------------------------------------------

    # Assumed packet size = 1500 bytes
    packet_size_bits = (
        1500 * 8
    )

    total_bits = (
        delivered
        * packet_size_bits
    )

    total_time_seconds = (
        max(
            total_delay,
            1e-6
        )
        / 1000.0
    )

    throughput_mbps = (
        total_bits
        / total_time_seconds
        / 1e6
    )


    return {
        "delay": avg_delay,
        "loss": loss_rate,
        "pdr": pdr,
        "jitter": jitter,
        "throughput": throughput_mbps,
        "delivered": delivered,
        "hops": (
            np.mean(hop_counts)
            if hop_counts
            else 0.0
        )
    }


