# ============================================================
# 40. SAMPLE LEARNED ROUTING DECISIONS
# ============================================================

print(
    "\n=========================================="
)

print(
    "SAMPLE LEARNED NEXT-HOP DECISIONS"
)

print(
    "=========================================="
)

sample_nodes = list(
    G.nodes()
)[:5]

for node in sample_nodes:

    neighbors = list(
        G.neighbors(node)
    )

    if not neighbors:
        continue

    state = get_state(
        G,
        node,
        random.choice(
            list(G.nodes())
        )
    )

    values = {
        neighbor:
        agent.q[
            (state, neighbor)
        ]

        for neighbor in neighbors
    }

    print(
        f"\nNode: {node}"
    )

    print(
        "Q-values:",
        values
    )

    best_neighbor = max(
        values,
        key=values.get
    )

    print(
        "Selected next-hop:",
        best_neighbor
    )


